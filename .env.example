# ParcelFlow — Environment Template
# Copy to .env and fill real values. Never commit .env with real passwords.

# --- Database (shared MySQL instance, table ownership by code) ---
DB_HOST=localhost
DB_PORT=3306
DB_NAME=parcelflow
DB_USER=parcelflow_app
DB_PASSWORD=change_me_locally

# --- Service Ports (local) ---
SHIPMENT_SERVICE_PORT=8081
TRACKING_SERVICE_PORT=8082
NOTIFICATION_SERVICE_PORT=8083

# --- Service URLs (local dev: localhost; Docker Compose: service names) ---
# Local:
SHIPMENT_SERVICE_URL=http://localhost:8081
TRACKING_SERVICE_URL=http://localhost:8082
NOTIFICATION_SERVICE_URL=http://localhost:8083
# Docker Compose example (uncomment inside containers):
# SHIPMENT_SERVICE_URL=http://shipment-service:8081
# TRACKING_SERVICE_URL=http://tracking-service:8082
# NOTIFICATION_SERVICE_URL=http://notification-service:8083
# DB_HOST=mysql  (Docker Compose service name)

# --- Frontend CORS ---
FRONTEND_ORIGIN=http://localhost:5173

# --- Frontend (public, no secrets) ---
VITE_SHIPMENT_API_URL=http://localhost:8081
VITE_TRACKING_API_URL=http://localhost:8082
VITE_NOTIFICATION_API_URL=http://localhost:8083
